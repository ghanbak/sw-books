# Admin tool environment (Next.js reads admin/.env.local automatically).
# These are SERVER-ONLY. Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
#
# The admin targets either the local or the production database, toggled by the
# in-app Local/Production switch. Both service-role keys are RLS-bypassing —
# keep them out of git.

# Local stack — values from `supabase status` (newer CLI labels the key "secret").
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_SERVICE_ROLE_KEY=

# Production — URL + secret key from the Supabase dashboard (Project Settings → API).
SUPABASE_PROD_URL=https://your-ref.supabase.co
SUPABASE_PROD_SERVICE_ROLE_KEY=

# Optional. Google Books API key — keyless access is quota-limited to ~0/day
# and returns HTTP 429, so lookups skip Google Books without one. Create a key
# at console.cloud.google.com (enable the "Books API"), no referrer restriction.
GOOGLE_BOOKS_API_KEY=

# --- Auth gate (production only) ---
# The gate enforces only in production builds (Vercel). Local `next dev` is
# loopback and stays ungated, so these can be left blank for local development.
#
# Identity is verified against the PRODUCTION Supabase project (where Google
# OAuth + your account live). These are PUBLISHABLE (anon) values — safe to be
# NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated allowlist of Supabase auth user ids permitted into /admin.
# After your first Google login the /login page prints your id to paste here.
ADMIN_USER_IDS=

# The deployed origin (e.g. https://admin.ossusarchives.com) for the Server
# Actions Origin/CSRF check. Leave blank for local.
ADMIN_ALLOWED_ORIGIN=
