# Admin tool environment (Next.js reads admin/.env.local automatically).
# These are SERVER-ONLY. Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
#
# Get both values from `supabase status` (run from the repo root with the
# local stack up). Newer Supabase CLI labels the privileged key "secret".

SUPABASE_URL=http://127.0.0.1:54321

# The secret / service-role key. RLS-bypassing — keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=
