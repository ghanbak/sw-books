EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
# Web Client ID from Google Cloud Console (auth checklist § 2b) — used by GoogleSignin.configure for the idToken Supabase verifies
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
# iOS Client ID from Google Cloud Console (auth checklist § 2c) — canonical form (...apps.googleusercontent.com); required by the native iOS module
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here
