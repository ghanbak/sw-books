EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
# Web Client ID from Google Cloud Console (auth checklist § 2b) — used by GoogleSignin.configure for the idToken Supabase verifies
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
# iOS Client ID from Google Cloud Console (auth checklist § 2c) — canonical form (...apps.googleusercontent.com); required by the native iOS module
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here

GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Production catalog seed target — used by `npm run db:seed:prod`.
# Copy to .env.production (gitignored) and fill from the Supabase dashboard
# → Project Settings → API. NEVER commit the real .env.production.

SUPABASE_LOCAL_URL=http://127.0.0.1:54321

# The secret / service-role key (RLS-bypassing). Keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here