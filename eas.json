{
	"cli": {
		"version": ">= 18.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"channel": "development",
			"developmentClient": true,
			"distribution": "internal",
			"ios": {
				"simulator": true
			}
		},
		"development-device": {
			"channel": "development",
			"developmentClient": true,
			"distribution": "internal",
			"autoIncrement": true,
			"ios": {
				"resourceClass": "m-medium"
			}
		},
		"preview": {
			"channel": "preview",
			"distribution": "internal",
			"ios": {
				"resourceClass": "m-medium"
			}
		},
		"production": {
			"channel": "production",
			"distribution": "store",
			"autoIncrement": true,
			"ios": {
				"resourceClass": "m-medium"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleId": "ghanbak@icloud.com",
				"ascAppId": "6766580620",
				"appleTeamId": "CFRQCUM2P9"
			}
		}
	}
}
