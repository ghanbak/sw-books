# Secrets used by `supabase/config.toml` for native OAuth providers.
# Copy this file to `supabase/.env` and fill in the real values.
# `supabase/.env` is gitignored.

# Apple Sign-In Supabase client secret JWT. Generated from Team ID + Key ID +
# Service ID (`com.ghanbak.ossusarchives.signin`) + .p8 private key.
# Generator: https://supabase.com/docs/guides/auth/social-login/auth-apple#generate-a-client-secret
# Valid 6 months — same JWT works for local + cloud Supabase.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Google Web Client Secret from Google Cloud Console (auth checklist § 2b).
# Same value pasted into cloud Supabase Dashboard → Authentication → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
