{
	"name": "ossus-archives",
	"main": "expo-router/entry",
	"version": "1.4.0",
	"private": true,
	"scripts": {
		"postinstall": "patch-package",
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "biome check . && bash scripts/check-admin-bundle.sh",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p .",
		"verify": "biome check . && npm run typecheck && npm test",
		"verify:admin": "npm --prefix admin run lint && (cd admin && npx tsc --noEmit -p . && npx next build) && bash scripts/check-admin-bundle.sh",
		"version": "node scripts/sync-app-version.mjs",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript > lib/types.ts",
		"db:seed": "npx tsx scripts/seed.ts",
		"db:seed:prod": "npx tsx scripts/seed.ts --production",
		"catalog:export": "npx tsx scripts/export-db-to-csv.ts",
		"catalog:export:prod": "npx tsx scripts/export-db-to-csv.ts --production",
		"catalog:backup": "bash scripts/catalog-backup.sh",
		"catalog:restore": "npx tsx scripts/restore-from-backup.ts",
		"catalog:changeset": "npx tsx scripts/build-catalog-changeset.ts --production",
		"catalog:apply": "npx tsx scripts/apply-catalog-changeset.ts --production",
		"catalog:cleanup": "npx tsx scripts/build-catalog-cleanup.ts --production",
		"catalog:enrich": "npx tsx scripts/enrich-wookieepedia.ts",
		"catalog:health": "npx tsx scripts/catalog-health.ts",
		"admin": "npm --prefix admin run dev",
		"admin:install": "npm --prefix admin install",
		"admin:predev": "npm run db:types"
	},
	"dependencies": {
		"@expo/ui": "~56.0.26",
		"@expo/vector-icons": "^15.0.3",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-google-signin/google-signin": "^16.1.2",
		"@shopify/flash-list": "2.0.2",
		"@supabase/supabase-js": "^2.103.0",
		"expo": "~56.0.23",
		"expo-apple-authentication": "~56.0.4",
		"expo-build-properties": "~56.0.27",
		"expo-camera": "~56.0.8",
		"expo-constants": "~56.0.18",
		"expo-crypto": "~56.0.5",
		"expo-dev-client": "~56.0.27",
		"expo-file-system": "~56.0.8",
		"expo-font": "~56.0.7",
		"expo-glass-effect": "~56.0.4",
		"expo-haptics": "~56.0.3",
		"expo-image": "~56.0.13",
		"expo-linear-gradient": "~56.0.4",
		"expo-linking": "~56.0.18",
		"expo-router": "56.2.21",
		"expo-sensors": "~56.0.6",
		"expo-splash-screen": "~56.0.15",
		"expo-status-bar": "~56.0.4",
		"expo-symbols": "~56.0.7",
		"expo-system-ui": "~56.0.5",
		"expo-text-extractor": "^2.0.0",
		"expo-updates": "~56.0.28",
		"expo-web-browser": "~56.0.6",
		"fast-text-encoding": "1.0.6",
		"isbn3": "^2.0.7",
		"react": "19.2.3",
		"react-content-loader": "^7.1.2",
		"react-dom": "19.2.3",
		"react-native": "0.85.3",
		"react-native-gesture-handler": "~2.31.1",
		"react-native-reanimated": "4.3.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "4.26.2",
		"react-native-svg": "15.15.4",
		"react-native-url-polyfill": "^3.0.0",
		"react-native-web": "^0.21.0",
		"react-native-webgpu": "0.15.1",
		"react-native-worklets": "^0.8.3",
		"three": "0.186.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/react": "~19.2.14",
		"@types/three": "0.186.0",
		"csv-parse": "^7.0.2",
		"csv-stringify": "^6.7.0",
		"p-limit": "6.2.0",
		"patch-package": "8.0.1",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11",
		"zod": "^4.4.3"
	},
	"overrides": {
		"@babel/core": "^7.29.13",
		"@xmldom/xmldom": "^0.8.15",
		"postcss": "^8.5.23",
		"brace-expansion@5": "^5.0.12",
		"uuid": "11.1.1",
		"ws@7": "^7.5.11",
		"ws@8": "^8.21.0",
		"shell-quote": "^1.11.0"
	}
}
