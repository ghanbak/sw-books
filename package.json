{
  "name": "ossus-archives",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check . && bash scripts/check-admin-bundle.sh",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/types.ts",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:seed:prod": "npx tsx scripts/seed.ts --production",
    "catalog:export": "npx tsx scripts/export-db-to-csv.ts",
    "catalog:export:prod": "npx tsx scripts/export-db-to-csv.ts --production",
    "catalog:backup": "bash scripts/catalog-backup.sh",
    "catalog:restore": "npx tsx scripts/restore-from-backup.ts",
    "admin": "npm --prefix admin run dev",
    "admin:install": "npm --prefix admin install",
    "admin:predev": "npm run db:types"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.6",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.103.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "^56.0.17",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-text-extractor": "^2.0.0",
    "expo-web-browser": "~15.0.10",
    "isbn3": "^2.0.7",
    "lucide-react-native": "^1.8.0",
    "react": "19.1.0",
    "react-content-loader": "^7.1.2",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/react": "~19.1.10",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "p-limit": "6.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "postcss": "8.5.10",
    "brace-expansion@5": "5.0.6",
    "uuid": "11.1.1",
    "ws@8": "8.20.1",
    "shell-quote": "1.8.4"
  }
}
