# Production catalog seed target — used by `npm run db:seed:prod`.
# Copy to .env.production (gitignored) and fill from the Supabase dashboard
# → Project Settings → API. NEVER commit the real .env.production.

SUPABASE_URL=https://<project-ref>.supabase.co

# The secret / service-role key (RLS-bypassing). Keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=
